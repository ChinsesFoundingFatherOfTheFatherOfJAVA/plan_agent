# 智能排产计划Agent - 环境变量配置模板
# 使用方法：复制本文件为 .env 并填入真实值

# LLM配置
LLM_PROVIDER=deepseek
LLM_MODEL_NAME=deepseek-v4-pro
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=http://your-llm-host:port/v1

# PostgreSQL配置
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=plan_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# Redis配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Milvus配置
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=plan_agent_knowledge

# Celery配置
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# OR-Tools配置
ORTOOLS_MAX_TIME_SECONDS=30
ORTOOLS_NUM_WORKERS=8

# RAG配置
RAG_BACKEND=milvus
RAG_KB_PATH=templates/knowledge.xlsx

# 钉钉配置
DINGTALK_APP_ID=your_app_id_here
DINGTALK_AGENT_ID=your_agent_id_here
DINGTALK_CLIENT_ID=your_client_id_here
DINGTALK_CLIENT_SECRET=your_client_secret_here

# 日志级别
LOG_LEVEL=INFO
